	(text "Hub power / reset support:"
		(exclude_from_sim no)
		(at 190 25 0)
		(effects
			(font (size 1.05 1.05)
				(bold yes))
		)
		(uuid "40000000-0000-4000-8000-000000004224")
	)
	(text "VDDA33 pins 5/10/29/36: 0.1µF each + shared 1µF bulk; VDD33 pins 15/23: 0.1µF each."
		(exclude_from_sim no)
		(at 190 31 0)
		(effects
			(font (size 0.92 0.92))
		)
		(uuid "40000000-0000-4000-8000-000000004225")
	)
	(text "CRFILT and PLLFILT are separate: each gets 10nF + 100nF low-ESR to GND; never tie the two filter pins together."
		(exclude_from_sim no)
		(at 190 37 0)
		(effects
			(font (size 0.92 0.92))
		)
		(uuid "40000000-0000-4000-8000-000000004226")
	)
	(text "TEST pin 11 → GND. Exposed VSS pad → solid ground plane with multiple vias."
		(exclude_from_sim no)
		(at 190 43 0)
		(effects
			(font (size 0.92 0.92))
		)
		(uuid "40000000-0000-4000-8000-000000004227")
	)
	(text "RESET_N: 10k pull-up + 1µF startup delay; Pico-B GP22 can assert hard reset. Add supervisor only if measured rail timing later demands it."
		(exclude_from_sim no)
		(at 190 49 0)
		(effects
			(font (size 0.92 0.92))
		)
		(uuid "40000000-0000-4000-8000-000000004228")
	)
	(text "3V3_AUX comes from TLV62569P on POWER sheet."
		(exclude_from_sim no)
		(at 190 55 0)
		(effects
			(font (size 0.92 0.92)
				(bold yes))
		)
		(uuid "40000000-0000-4000-8000-000000004229")
	)
	(text "Front-board interface is now 20 logical positions:"
		(exclude_from_sim no)
		(at 210 130 0)
		(effects
			(font (size 1.05 1.05)
				(bold yes))
		
			(justify left))
		(uuid "40000000-0000-4000-8000-000000004230")
	)
	(text "2×5V + 4×GND + 3V3_AUX + I²C + INT + BOARD_ID/ENABLE + two USB2 pairs + PRTPWR/OCS per bank."
		(exclude_from_sim no)
		(at 210 136 0)
		(effects
			(font (size 0.92 0.92))
		
			(justify left))
		(uuid "40000000-0000-4000-8000-000000004231")
	)
	(text "This lets PRIMARY and EXTENDED use the same PCB while Pico-B can read selector/fault state over I²C."
		(exclude_from_sim no)
		(at 210 142 0)
		(effects
			(font (size 0.92 0.92))
		
			(justify left))
		(uuid "40000000-0000-4000-8000-000000004232")
	)
	(text "Exact physical keyed/locking connector remains TBD; do NOT assume standard PC USB3 pinout."
		(exclude_from_sim no)
		(at 210 148 0)
		(effects
			(font (size 0.92 0.92)
				(bold yes))
		
			(justify left))
		(uuid "40000000-0000-4000-8000-000000004233")
	)
	(text "Hub map: DN1=PRIMARY-1 · DN2=PRIMARY-2 · DN3=EXTENDED-3 · DN4=EXTENDED-4."
		(exclude_from_sim no)
		(at 20 160 0)
		(effects
			(font (size 1 1)
				(bold yes))
		
			(justify left))
		(uuid "40000000-0000-4000-8000-000000004234")
	)
	(text "Each A/C receptacle has local current-limit/backfeed protection; either fault drives that bank OCS_N."
