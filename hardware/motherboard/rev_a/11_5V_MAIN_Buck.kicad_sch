  (text "LM25149-Q1 single-phase FPWM + DRSS + active EMI filter. Frozen Rev-A target: 5.0V / 12A hardware capability." (exclude_from_sim no) (at 18 17 0) (effects (font (size 0.76 0.76) (bold yes)) (justify left)) (uuid "de000000-0000-4000-8000-000000000381"))
  (text "Input envelope follows selected-source SYS_IN (~8.1–23V steady-state). Source-aware firmware must not treat 12A as universal source entitlement." (exclude_from_sim no) (at 18 21 0) (effects (font (size 0.70 0.70)) (justify left)) (uuid "de000000-0000-4000-8000-000000000382"))
  (text "AEF: XGL6060 1uH, CSEN 0.1uF, CINJ 0.47uF, CDAMP 0.22uF || RDAMP 17.8R, CAEFC 1nF + RAEFC 1k, RAEFDC 49.9k, CINC 0.1uF + RINC 0.47R." (exclude_from_sim no) (at 18 25 0) (effects (font (size 0.66 0.66)) (justify left)) (uuid "de000000-0000-4000-8000-000000000383"))
  (text "Power train: 2x IAUC60N04S6L039 → XGL1010 2.2uH → 3mR KRL2012E shunt → 8x47uF 1210 → 5V_MAIN." (exclude_from_sim no) (at 18 29 0) (effects (font (size 0.66 0.66)) (justify left)) (uuid "de000000-0000-4000-8000-000000000384"))
  (text "Controller straps: RT 49.9k; CNFG 41.2k (primary / DRSS / single phase); PFM/SYNC=GND (FPWM); FB 24.9k to VDDA (fixed 5V); VCCX=5V_MAIN." (exclude_from_sim no) (at 18 33 0) (effects (font (size 0.66 0.66)) (justify left)) (uuid "de000000-0000-4000-8000-000000000385"))
  (text "Loop: RCOMP 5.90k, CCOMP 10nF, CHF DNP (22pF tuning option). UVLO: 49.9k / 8.06k from SYS_IN → EN → GND." (exclude_from_sim no) (at 18 37 0) (effects (font (size 0.66 0.66)) (justify left)) (uuid "de000000-0000-4000-8000-000000000386"))
  (text "PGOOD is open-drain with 100k pull-up to 3V3_AUX; receiving GPIO remains TBD. Keep Kelvin shunt sense and TI ground/EP layout discipline in PCB phase." (exclude_from_sim no) (at 18 201 0) (effects (font (size 0.66 0.66) (bold yes)) (justify left)) (uuid "de000000-0000-4000-8000-000000000387"))
