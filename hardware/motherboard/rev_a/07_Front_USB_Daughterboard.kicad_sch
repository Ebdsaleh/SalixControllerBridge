	(global_label "3V3_AUX" (shape passive) (at 386.19 100 0) (effects (font (size 0.82 0.82)) (justify right bottom)) (uuid "61000000-0000-4000-8000-000000006184"))
	(label "FRONT_INT_N" (at 393.81 100 0) (effects (font (size 0.82 0.82)) (justify left bottom)) (uuid "61000000-0000-4000-8000-000000006185"))
	(text "HARDWARE ISOLATION TRUTH:"
		(exclude_from_sim no)
		(at 20 158 0)
		(effects
			(font (size 1.05 1.05)
				(bold yes))
		
			(justify left))
		(uuid "60000000-0000-4000-8000-000000006487")
	)
	(text "RUN_x = 1 from 10k pull-up when jumper OPEN; shorting jumper forces RUN_x=0 and directly disables that port's VBUS switch."
		(exclude_from_sim no)
		(at 20 164 0)
		(effects
			(font (size 0.88 0.88))
		
			(justify left))
		(uuid "60000000-0000-4000-8000-000000006488")
	)
	(text "SN74LVC2G157 selects RUN_A or RUN_C using the same mechanical SEL. Its complement output Y_N drives TS3USB221A OE."
		(exclude_from_sim no)
		(at 20 170 0)
		(effects
			(font (size 0.88 0.88))
		
			(justify left))
		(uuid "60000000-0000-4000-8000-000000006489")
	)
	(text "BOARD_ENABLE_N is fail-safe pulled HIGH: HIGH forces Y_N=HIGH → USB data disconnected. Motherboard must actively pull LOW to enable board data."
		(exclude_from_sim no)
		(at 20 176 0)
		(effects
			(font (size 0.88 0.88)
				(bold yes))
		
			(justify left))
		(uuid "60000000-0000-4000-8000-000000006490")
	)
	(text "Therefore: selected enabled port + board enabled => OE LOW/connect; selected jumper short OR board disabled => OE HIGH/disconnect."
		(exclude_from_sim no)
		(at 20 182 0)
		(effects
			(font (size 0.88 0.88)
				(bold yes))
		
			(justify left))
		(uuid "60000000-0000-4000-8000-000000006491")
	)
	(text "The other physical receptacle remains powered for charge-only operation while the hub logical port is ON; PRTPWR gates both A/C VBUS paths."
		(exclude_from_sim no)
		(at 20 188 0)
		(effects
			(font (size 0.88 0.88))
		
			(justify left))
		(uuid "60000000-0000-4000-8000-000000006492")
	)
	(text "TYPE-C SUPPORT:"
		(exclude_from_sim no)
		(at 20 202 0)
		(effects
			(font (size 1.05 1.05)
				(bold yes))
		
			(justify left))
		(uuid "60000000-0000-4000-8000-000000006493")
	)
	(text "TPS25821: 3×47µF = 141µF at IN, 4.7µF at OUT/VBUS, 100k 0.5% REF. CHG has 100k pulldown so power-up default is STD advertisement."
		(exclude_from_sim no)
		(at 20 208 0)
		(effects
			(font (size 0.86 0.86))
		
			(justify left))
		(uuid "60000000-0000-4000-8000-000000006494")
	)
	(text "FAULT_N / SINK_N are open drain and are monitored by TCA9535; CC1/CC2 connect directly to receptacle. Type-C VBUS remains cold-socketed."
		(exclude_from_sim no)
		(at 20 214 0)
		(effects
			(font (size 0.86 0.86))
		
			(justify left))
		(uuid "60000000-0000-4000-8000-000000006495")
	)
	(text "MANAGEMENT:"
		(exclude_from_sim no)
		(at 20 228 0)
		(effects
			(font (size 1.05 1.05)
				(bold yes))
		
			(justify left))
		(uuid "60000000-0000-4000-8000-000000006496")
	)
	(text "TCA9535: P00/P01=SEL; P02–P05=FAULT; P06/P07=SINK; P10–P13=LED; P14/P15=RUN; P16/P17=CHG."
		(exclude_from_sim no)
		(at 20 234 0)
		(effects
			(font (size 0.86 0.86))
		
			(justify left))
		(uuid "60000000-0000-4000-8000-000000006497")
	)
	(text "A0=BOARD_ID; A1=A2=GND. I²C pull-ups live on the motherboard."
		(exclude_from_sim no)
		(at 20 240 0)
		(effects
			(font (size 0.86 0.86))
		
			(justify left))
		(uuid "60000000-0000-4000-8000-000000006498")
	)
	(text "PRTPWR (active HIGH) gates both A/C VBUS switches; either FAULT_N pulls bank OCS_N LOW."
		(exclude_from_sim no)
		(at 20 246 0)
		(effects
			(font (size 0.86 0.86)
				(bold yes))
		
			(justify left))
		(uuid "60000000-0000-4000-8000-000000006499")
	)
	(text "Switch and USB receptacle footprints stay TBD until the enclosure dimensions are frozen."
		(exclude_from_sim no)
		(at 20 252 0)
		(effects
			(font (size 0.86 0.86)
				(bold yes))
		
			(justify left))
		(uuid "60000000-0000-4000-8000-000000006500")
	)
	(text "USB2 DATA ONLY in Rev A. Hub logical port ON powers both physical A/C receptacles (subject to each service jumper); only the selected receptacle owns USB data."
		(exclude_from_sim no)
		(at 20 278 0)
		(effects
			(font (size 1 1)
				(bold yes))
		
			(justify left))
		(uuid "60000000-0000-4000-8000-000000006501")
	)
